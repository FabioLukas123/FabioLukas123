{
  "name": "the-city",
  "version": "1.0.0",
  "description": "THE CITY — an explorable Dark Deco metropolis built with WebGL and a generative noir-jazz score.",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.js",
    "serve": "node scripts/serve.js",
    "dev": "node scripts/serve.js",
    "build": "esbuild src/main.js --bundle --format=esm --minify --outfile=dist/city.bundle.js",
    "rebuild": "npm install && npm run build",
    "watch": "esbuild src/main.js --bundle --format=esm --sourcemap --outfile=dist/city.bundle.js --watch"
  },
  "keywords": ["webgl", "three.js", "art-deco", "noir", "generative-music", "interactive"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "playwright": "^1.61.1"
  }
}
